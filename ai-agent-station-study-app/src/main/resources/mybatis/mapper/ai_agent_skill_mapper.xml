<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.bugstack.ai.infrastructure.dao.IAiAgentSkillDao">
    <resultMap id="AiAgentSkillMap" type="cn.bugstack.ai.infrastructure.dao.po.AiAgentSkill">
        <id column="id" property="id"/>
        <result column="agent_id" property="agentId"/>
        <result column="skill_id" property="skillId"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" parameterType="cn.bugstack.ai.infrastructure.dao.po.AiAgentSkill" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_agent_skill (agent_id, skill_id, status, create_time)
        VALUES (#{agentId}, #{skillId}, #{status}, #{createTime})
    </insert>

    <select id="queryByAgentId" parameterType="java.lang.String" resultMap="AiAgentSkillMap">
        SELECT id, agent_id, skill_id, status, create_time FROM ai_agent_skill WHERE agent_id = #{agentId}
    </select>

    <delete id="deleteByAgentId" parameterType="java.lang.String">
        DELETE FROM ai_agent_skill WHERE agent_id = #{agentId}
    </delete>

    <delete id="deleteByAgentAndSkill">
        DELETE FROM ai_agent_skill WHERE agent_id = #{agentId} AND skill_id = #{skillId}
    </delete>
</mapper>
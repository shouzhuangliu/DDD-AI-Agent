<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.bugstack.ai.infrastructure.dao.IAiAgentMcpDao">
    <resultMap id="AiAgentMcpMap" type="cn.bugstack.ai.infrastructure.dao.po.AiAgentMcp">
        <id column="id" property="id"/>
        <result column="agent_id" property="agentId"/>
        <result column="mcp_id" property="mcpId"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" parameterType="cn.bugstack.ai.infrastructure.dao.po.AiAgentMcp" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_agent_mcp (agent_id, mcp_id, status, create_time)
        VALUES (#{agentId}, #{mcpId}, #{status}, #{createTime})
    </insert>

    <select id="queryByAgentId" parameterType="java.lang.String" resultMap="AiAgentMcpMap">
        SELECT id, agent_id, mcp_id, status, create_time FROM ai_agent_mcp WHERE agent_id = #{agentId}
    </select>

    <delete id="deleteByAgentId" parameterType="java.lang.String">
        DELETE FROM ai_agent_mcp WHERE agent_id = #{agentId}
    </delete>

    <delete id="deleteByAgentAndMcp">
        DELETE FROM ai_agent_mcp WHERE agent_id = #{agentId} AND mcp_id = #{mcpId}
    </delete>
</mapper>
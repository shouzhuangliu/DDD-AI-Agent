 <resultMap id="M" type="cn.bugstack.ai.infrastructure.dao.po.MemoryState"><id column="id" property="id"/><result column="agent_id" property="agentId"/><result column="session_id" property="sessionId"/><result column="version" property="version"/><result column="goals_json" property="goalsJson"/><result column="constraints_json" property="constraintsJson"/><result column="entities_json" property="entitiesJson"/><result column="pending_json" property="pendingJson"/><result column="completed_json" property="completedJson"/><result column="created_at" property="createdAt"/></resultMap>
